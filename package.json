{
  "name": "oop-renewed",
  "version": "1.0.0",
  "description": "Offline-resilient subscription & renewal tracker for Synology NAS with Telegram bot",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "subscriptions",
    "renewal",
    "synology",
    "nas",
    "docker",
    "telegram-bot",
    "sqlite"
  ],
  "author": "Oops, Renewed!",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
